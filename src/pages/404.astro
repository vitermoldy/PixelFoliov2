---
import Base from '../layouts/Base.astro';
---

<Base title="Halaman tidak ditemukan" description="Halaman yang Anda cari tidak ada.">
  <section class="wrap notfound">
    <p class="px-label">Kesalahan 404</p>
    <h1>Halaman ini tidak ditemukan</h1>
    <p class="lead">Tautannya mungkin salah ketik atau halamannya sudah dipindah.</p>
    <a class="btn" href="/">Kembali ke halaman utama</a>
  </section>
</Base>

<style>
  .notfound {
    display: grid;
    gap: 24px;
    justify-items: start;
    padding-top: 120px;
    padding-bottom: 160px;
  }

  h1 {
    font-size: clamp(44px, 7vw, 104px);
    line-height: 0.95;
    letter-spacing: -0.045em;
    max-width: 14ch;
  }
</style>
