---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import About from '../components/About.astro';
import Process from '../components/Process.astro';
import { profile } from '../data/profile';

/*
 * Rencana halaman (taste-skill + antislop):
 * kind: service (portofolio perorangan), site-kind software (karya digital)
 * Design Read: portofolio desainer/developer untuk calon klien, editorial kertas-dan-tinta
 *   dengan motif piksel, dial ENERGY 3 / RHYTHM 3 / MOTION 2
 * #atas     hero + papan piksel interaktif (satu-satunya efek), 1 layar
 * #karya    proyek unggulan di panel gelap, 1 layar
 * #arsip    indeks baris + panel pratinjau sampul, 1 layar
 * #tentang  dua kolom editorial + daftar alat, 1 layar
 * #proses   panel gelap, empat tahap dengan bar progres piksel, 1 layar
 * #kontak   footer penutup: ajakan kontak + nama piksel + baris legal, 1 layar
 */
---

<Base
  title={`${profile.name}, ${profile.role} di ${profile.city}`}
  description={profile.intro}
>
  <Hero />
  <Work />
  <About />
  <Process />
</Base>
