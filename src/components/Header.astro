---
import { profile } from '../data/profile';

const base = Astro.url.pathname === '/' ? '' : '/';
const links = [
  { href: `${base}#karya`, label: 'Karya' },
  { href: `${base}#tentang`, label: 'Tentang' },
  { href: `${base}#proses`, label: 'Proses' },
  { href: `${base}#kontak`, label: 'Kontak' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${profile.name}, halaman utama`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span>{profile.name}</span>
    </a>

    <nav class="nav" aria-label="Navigasi utama">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--sm nav-cta" href={`mailto:${profile.email}`}>Kirim email</a>

    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="menu-ponsel"
      data-menu-toggle
    >
      <span class="visually-hidden" data-menu-label>Buka menu</span>
      <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="mobile-menu" id="menu-ponsel" hidden>
    <nav aria-label="Navigasi ponsel">
      <ul>
        {
          links.map((l, i) => (
            <li>
              <a href={l.href} data-menu-link>
                <span class="px-label">0{i + 1}</span>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn" href={`mailto:${profile.email}`}>Kirim email</a>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('menu-ponsel');
  const label = document.querySelector('[data-menu-label]');

  if (toggle && menu && label) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Tutup menu' : 'Buka menu';
      menu.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // tandai tautan navigasi untuk bagian yang sedang terlihat
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav a[href*="#"]')];
  // bagian tanpa tautan sendiri ikut menandai tautan induknya
  const alias: Record<string, string> = { arsip: 'karya' };
  const targets = [...navLinks.map((a) => a.hash.slice(1)), ...Object.keys(alias)]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el);

  if (targets.length && 'IntersectionObserver' in window) {
    const mark = (id: string | null) => {
      navLinks.forEach((a) => {
        if (id && a.hash === `#${id}`) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    };
    const visible = new Map<string, number>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => visible.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0));
        let best = '';
        let max = 0.2;
        for (const [id, ratio] of visible) {
          if (ratio > max) {
            max = ratio;
            best = id;
          }
        }
        mark(best ? (alias[best] ?? best) : null);
      },
      { threshold: [0, 0.2, 0.4, 0.6, 0.8, 1], rootMargin: '-64px 0px 0px 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    font-size: 17px;
    letter-spacing: -0.01em;
    text-decoration: none;
    min-height: 44px;
  }

  .brand-mark {
    width: 12px;
    height: 12px;
    background: var(--accent);
    box-shadow: 12px 0 0 var(--ink);
    margin-right: 12px;
  }

  .nav {
    margin-left: auto;
  }

  .nav ul {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    font-size: 16px;
    background: linear-gradient(currentColor, currentColor) left calc(100% - 8px) / 0% 2px no-repeat;
    transition: background-size var(--m-out) var(--m-ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav a:hover {
      background-size: 100% 2px;
      transition-duration: var(--m-in);
    }
  }

  /* bagian yang sedang dibaca: garis tetap di bawah kata */
  .nav a[aria-current] {
    background-size: 100% 2px;
  }

  :global(.btn.btn--sm) {
    min-height: 44px;
    padding: 10px 18px;
    font-size: 15px;
  }

  .menu-btn {
    display: none;
    margin-left: auto;
    width: 48px;
    height: 48px;
    border: 0;
    background: var(--ink);
    color: var(--paper);
    clip-path: var(--px-corners);
    align-items: center;
    justify-content: center;
  }

  .menu-icon {
    display: grid;
    gap: 6px;
  }

  .menu-icon i {
    display: block;
    width: 20px;
    height: 3px;
    background: currentColor;
    transition: transform var(--m-out) var(--m-ease);
  }

  .menu-btn[aria-expanded='true'] .menu-icon i:first-child {
    transform: translateY(4.5px) rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] .menu-icon i:last-child {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--paper);
    padding: 32px var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow-y: auto;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-menu li {
    border-top: 1px solid var(--line);
  }

  .mobile-menu li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu a[data-menu-link] {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .mobile-menu .btn {
    width: 100%;
    margin-top: 32px;
  }

  @media (max-width: 899px) {
    .nav {
      display: none;
    }

    /* aksi utama tetap di bar, di samping tombol menu */
    .nav-cta {
      margin-left: auto;
    }

    .menu-btn {
      display: inline-flex;
      margin-left: 0;
    }

    .bar {
      gap: 12px;
    }
  }

  @media (max-width: 359px) {
    .nav-cta {
      display: none;
    }

    .menu-btn {
      margin-left: auto;
    }
  }
</style>
